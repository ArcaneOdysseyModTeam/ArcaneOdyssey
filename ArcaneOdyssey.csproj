<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="..\tModLoader.targets" />
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DefineConstants>$(DefineConstants);VSDEBUGMODE</DefineConstants>
	</PropertyGroup>
	<PropertyGroup>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<DocumentationFile>$(AssemblyName).xml</DocumentationFile>
	</PropertyGroup>
	<ItemGroup>
		<AdditionalFiles Remove="references\**" />
		<Compile Remove="**\*.py" />
		<Compile Remove="**\*.kra" />
		<Compile Remove="**\*.kra~" />
		<Compile Remove="**\*.png~" />
		<Compile Remove="**\*.md" />
		<Compile Remove="**\*.tmod" />
		<Compile Remove="**\*.dll" />
		<Compile Remove="**\*.pdb" />
		<Compile Remove="**\*.kra" />
		<Compile Remove="references\**" />
		<EmbeddedResource Remove="references\**" />
		<None Remove="**\*.py" />
		<None Remove="**\*.kra~" />
		<None Remove="**\*.png~" />
		<None Remove="**\*.md" />
		<None Remove="**\*.tmod" />
		<None Remove="**\*.kra" />
		<None Remove="references\**" />
		<Reference Include="ArcaneOdysseyMusic">
			<HintPath>references\ArcaneOdysseyMusic.dll</HintPath>
		</Reference>
		<Reference Include="MagicStorage">
		  <HintPath>references\MagicStorage.dll</HintPath>
		</Reference>
		<Reference Include="StructureHelper">
		  <HintPath>references\StructureHelper.dll</HintPath>
		</Reference>
	</ItemGroup>
</Project>