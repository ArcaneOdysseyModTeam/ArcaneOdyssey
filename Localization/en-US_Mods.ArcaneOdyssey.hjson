# This file will automatically update with entries for new content after a build and reload.

Items: {
	SunkenSword: {
		DisplayName: Sunken Sword
		Tooltip:
			'''
			A medium-sized, one handed sword made out of arcanium metal that has spent hundreds of years underwater, causing its properties to change
			It seems to constantly produce water
			[c/700013:Special Ability]: [c/327DFF:Rising Tide] - Use right click to send yourself upwards, surrounding yourself with water.
			'''
	}

	ArcaniumScrap: {
		DisplayName: Arcanium Scrap
		Tooltip: A large chunk of arcanium metal that has spent hundreds of years under the sea, imbuing it with intense magical properties
	}

	HecateOrb: {
		DisplayName: Hecate Orb
		Tooltip: An orb of ancient power, which can be focused upon to obtain magic.
	}

	DefaultScroll: {
		DisplayName: Default Scroll
		Tooltip: An empty spell scroll
	}

	SunkenStaff: {
		DisplayName: Sunken Staff
		Tooltip:
			'''
			An ornate green and gold staff made out of arcanium metal that has spent hundreds of years underwater, causing its properties to change
			It seems to constantly produce water
			[c/700013:Special Ability]: [c/327DFF:Fury of the Sea] - Shoots a projectile that pierces through enemies and walls
			'''
	}

	LightningMagic: {
		DisplayName: Lightning Magic
		Tooltip: Allows the user to imbue swift bolts of destructive lightning
	}

	IceMagic: {
		DisplayName: Ice Magic
		Tooltip: Allows the user to imbue cold hard ice which can freeze and chill to the blood and bone
	}

	MagmaMagic: {
		DisplayName: Magma Magic
		Tooltip: Allows the user to imbue eruptions of thick, molten rock that melts all in its path.
	}

