Relics: {
	EaglePatrimony: {
		DisplayName: Eagle Patrimony
		Tooltip: Despite never seeing this pendant before, you remember this heirloom as if it were a part of yourself

		Ability: {
			DisplayName: Astrapikis
			Description: Release a slash of spirit energy
		}
	}

	Projectiles: {
		Astrapikis.DisplayName: Astrapikis
		SpiritBlast.DisplayName: Spirit Blast
		Nichtetheis.DisplayName: Nichtetheis
		Floganymai.DisplayName: Floganymai
		SpiritHound.DisplayName: Spirit Hound
		SpiritRaincloud.DisplayName: Spirit Raincloud
		SpiritRaindrop.DisplayName: Spirit Raindrop
	}

	EmberStaff: {
		DisplayName: Ember Staff
		Tooltip:
			'''
			A staff made out of the remains of a greathammer
			It was blessed by Hephaestus - the god of fire and blacksmithing
			'''

		Ability: {
			DisplayName: Floganymai
			Description: Release a pillar of spirit energy a short distance away from you, exploding several times
		}
	}

	NyxStaff: {
		DisplayName: Staff of Night
		Tooltip:
			'''
			An aged staff made of some kind of purple stone
			It was blessed by Nyx - the goddess of night
			'''

		Ability: {
			DisplayName: Nichtetheis
			Description: Fire a beam of spirit energy that disorients anyone it hits
		}
	}

	TidestoneBand: {
		DisplayName: Tidestone Band
		Tooltip:
			'''
			An armband made out of some kind of blue stone
			It was blessed by Poseidon - the god of the sea
			'''

		Ability: {
			DisplayName: Thakrousi
			Description: Surround yourself in spirit energy and leap forward, then release the energy in a large area
		}
	}

	CrystalOrb: {
		DisplayName: Crystal Orb
		Tooltip:
			'''
			An orb made of seemingly unbreakable crystal
			It was blessed by Aether - the god of light
			'''

		Ability: {
			DisplayName: Aithiraki
			Description: Summon a minion made of spirit energy
		}
	}

	SpiritEnergy: {
		DisplayName: Divine Spirit Energy
		Tooltip:
			'''
			Represents your ability to wield spirit energy without a relic, as a legacy
			Can be used like an imbue, but provides no benifits besides the ability to use rites
			'''
	}
}

SteamImbue: {
	DisplayName: Steam Imbue
	Tooltip: Created when something hot is imbued with something cold, or vice versa
}
