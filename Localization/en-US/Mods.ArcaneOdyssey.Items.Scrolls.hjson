Equipment: {
	Common: {
		CrashScroll: {
			DisplayName: Crash Technique
			Tooltip:
				'''
				Dash then slam
				Press {AODASHBIND} to activate
				'''
			SkillName: Crash
		}

		AuraScroll: {
			DisplayName: Aura Scroll
			Tooltip:
				'''
				Empowers life, attack size, or damage
				Life boost scales with imbue
				'''
			SkillName: Aura
		}

		HoverScroll: {
			DisplayName: Hover Spell
			Tooltip: Hover with magic
			SkillName: Hover
		}

		LeapScroll: {
			DisplayName: Jump Scroll
			Tooltip: Allows to weilder to double jump
			SkillName: Jump
		}

		BreathtakerTechnique: {
			DisplayName: Breathtaker Technique
			Tooltip:
				'''
				Dash into an enemy and lower their defense
				Press {AODASHBIND} to activate
				'''
			SkillName: Breathtaker
		}

		ReflexScroll: {
			DisplayName: Reflex Scroll
			Tooltip:
				'''
				Channels your imbue to dash
				Some imbues have special effects
				'''
			SkillName: Reflex

			Special: {
				Instant: Ignores enemy contact damage
				Fast: Dashes are faster than usual
				Resist: Provides defense while dashing
				Vanish: You turn invisible as you dash
				Thermo: Ignores enemy contact damage above 50%
				Sailor: Dashes faster above 50%
			}
		}
	}

	Rare: {
		FlightScroll: {
			DisplayName: Flight Scroll
			Tooltip: Channels your imbue to fly
			SkillName: Flight
		}

		WalkRite: {
			DisplayName: Walk Rite
			Tooltip:
				'''
				Dash thrice with your spirit energy
				Press {AODASHBIND} to activate
				'''
			SkillName: Walk
		}

		SelinoTechnique: {
			DisplayName: Selino Technique
			Tooltip:
				'''
				Dash thrice, releasing shockwaves
				Press {AODASHBIND} to activate
				'''
			SkillName: Selino
		}

		GreatjumpTechnique: {
			DisplayName: Greatjump Technique
			Tooltip:
				'''
				Kick off the air and launch upwards
				Press {AODASHBIND} to activate
				'''
			SkillName: Greatjump
		}
	}
}

