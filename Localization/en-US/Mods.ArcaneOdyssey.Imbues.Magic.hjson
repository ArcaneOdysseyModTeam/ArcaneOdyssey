Ancient: {
	IonMagic: {
		DisplayName: Ion Magic
		Tooltip:
			'''
			Allows the user to create and control scorching plasma that ionizes everything in its way, causing all forms of burning to be much more vile
			Dedicated to Gammaboy45
			'''
	}

	DeathMagic: {
		DisplayName: Death Magic
		Tooltip: Allows the user to manifest the aura of death, annihilating weaker foes and withering all

		Ability: {
			DisplayName: Absolute Death
			Description: Enemies with a lower max health than yours are instantly killed
		}
	}
}

