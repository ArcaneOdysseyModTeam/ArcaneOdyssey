FlightScroll: {
	DisplayName: Flight Scroll
	Tooltip: Channels your imbue to fly
}

HoverScroll: {
	DisplayName: Hover Spell
	Tooltip: Channels your magic to hover in the air
}

LeapScroll: {
	DisplayName: Leap Scroll
	Tooltip: Channels your magic to launch yourself upwards
}

BeamScroll: {
	DisplayName: Beam Spell
	Tooltip: Channels your magic into a beam
}

BlastScroll: {
	DisplayName: Blast Rite
	Tooltip: Channels your spirit energy into a blast
}

CannonScroll: {
	DisplayName: Cannon Spell
	Tooltip: Channels your magic into a large blast that pierces
}

ExplosionScroll: {
	DisplayName: Explosion Spell
	Tooltip: Channels your magic into an explosion that you can direct
}

PulsarScroll: {
	DisplayName: Pulsar Spell
	Tooltip: Channels your magic into an unstable projectile
}

CrashScroll: {
	DisplayName: Crash Technique
	Tooltip: Channels your fighting style to dash, use {DASHBIND}
}

ShotScroll: {
	DisplayName: Shot Technique
	Tooltip: Channels your fighting style to shoot a quick air blast
}

SmashScroll: {
	DisplayName: Smash Technique
	Tooltip: Channels your fighting style to unleash a shockwave of air
}

ReflexScroll: {
	DisplayName: Reflex Scroll
	Tooltip: Channels your imbue to dash, some imbues have special effects
}

HoundRite: {
	DisplayName: Hound Rite
	Tooltip: Channels your spirit energy into a hound-shaped blast that pierces once
}

ArrayScroll: {
	DisplayName: Array Scroll
	Tooltip: Channels your magic into a blast that aims towards your target
}
