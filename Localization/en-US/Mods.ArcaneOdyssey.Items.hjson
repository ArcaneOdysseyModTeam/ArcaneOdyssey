KindraBlade: {
	DisplayName: Kindra's Blade
	Tooltip:
		'''
		A blood red blade, there is probably a story behind this
		Guard Boi's Vanity Set
		'''
}

HecateShard: {
	DisplayName: Hecate Shard
	Tooltip: A shard of unknown origin... the world is not ready to unleash this
}

ArcaniumScrap: {
	DisplayName: Sunken Scrap
	Tooltip: A large chunk of arcanium metal that has spent hundreds of years under the sea, imbuing it with intense magical properties
}

PoseidonChoice: {
	DisplayName: Poseidon's Spirit
	Tooltip: An sigil of ancient power, which can be focused upon to grant power to those who are worthy
}

SunkenSword: {
	DisplayName: Sunken Sword
	Tooltip:
		'''
		A medium-sized, one handed sword made out of arcanium metal that has spent hundreds of years underwater, causing its properties to change
		It seems to constantly produce water
		[c/700013:Special Ability:] [c/327DFF:Rising Tide] - Use right click to send yourself upwards, surrounding yourself with water
		'''
}

SunkenStaff: {
	DisplayName: Sunken Staff
	Tooltip:
		'''
		An ornate green and gold staff made out of arcanium metal that has spent hundreds of years underwater, causing its properties to change
		It seems to constantly produce water
		[c/327DFF:Passive Ability: Fury of the Sea] - Shoots a projectile that pierces through enemies and walls
		'''
}

CommodoreKaiSabre: {
	DisplayName: Commodore Kai Sabre
	Tooltip: INCOMPLETE
}

BlastScroll: {
	DisplayName: Blast Scroll
	Tooltip: A spell scroll which allows the user to create a charged magical blast, or create a barrage of uncharged magical blasts
}

Paper: {
	DisplayName: Paper
	Tooltip: Organic parchment suitable for conducting magic
}

SunkenBoots: {
	DisplayName: Sunken Boots
	Tooltip:
		'''
		A green and gold pair of boots made out of arcanium metal that has spent hundreds of years underwater, causing its properties to change
		It seems to constantly produce water
		'''
	SetText: "[c/700013:Special Ability:] [c/327DFF:Aquatic Rebuttal] - Enemies that hit you are soaked"
}

SunkenChest: {
	DisplayName: Sunken Chestplate
	Tooltip:
		'''
		A green and gold chestplate made out of arcanium metal that has spent hundreds of years underwater, causing its properties to change
		It seems to constantly produce water
		'''
}

SunkenHelm: {
	DisplayName: Sunken Helmet
	Tooltip:
		'''
		A green and gold helmet made out of arcanium metal, designed to hide the wearer's eyes to enhance their senses that has spent hundreds of years underwater, causing its properties to change
		It seems to constantly produce water
		'''
}

WoodenPaddle: {
	DisplayName: Wooden Paddle
	Tooltip: A wooden paddle for a rowboat, it seems to contain trace magic
}

DarkSeaMusicBox: {
	DisplayName: Music Box (Dark Sea)
	Tooltip: Plays 'The Dark Sea' by Tobi
}

TitleMusicBox: {
	DisplayName: Music Box (Arcane Title)
	Tooltip: Plays 'The Call of Adventure' by Tobi
}

Acrimony: {
	DisplayName: Prometheus's Acrimony
	Tooltip: A legendary item that allows you to change your magic type
}

ExplosionScroll: {
	DisplayName: Explosion Scroll
	Tooltip: Creates an explosion at your cursor's position, or can hold you in place and turn you into the source
}

BronzeBar: {
	DisplayName: Bronze Bar
	Tooltip: An alloy that does nothing yet, you wasted your time obtaining this
}

ColossalGreatsword: {
	DisplayName: Colossal Greatsword
	Tooltip:
		'''
		An enourmous steel greatsword that was wielded by Evander the Mountainbreaker, a bounty hunter that wanders this land
		[c/700013:Special Ability: Colossal Cleave] - Shoots a projectile that pierces through enemies and walls
		'''
}

SteamImbue: {
	DisplayName: Steam Imbue
	Tooltip:
		'''
		By Valve

		Part of the mod internals, just ignore this, any spells with it will cause an error (It's used for imbues)
		'''
}

EmptyScroll: {
	DisplayName: Empty Scroll
	Tooltip: An empty scroll, made of organic paper
}

LeapScroll: {
	DisplayName: Leap Scroll
	Tooltip: ""
}

VesuvianSigil: {
	DisplayName: Vesuvian Sigil
	Tooltip:
		'''
		A strange emblem
		RedBirb's set
		'''
}

OldGreataxe: {
	DisplayName: Old Greataxe
	Tooltip: A large two-handed axe that is most likely decades old, but still seems to be usable
}

OldRapier: {
	DisplayName: Old Rapier
	Tooltip: A rapier that is most likely decades old, but it still seems to be usable
}

EaglePatrimony: {
	DisplayName: Eagle Patrimony
	Tooltip: Despite never seeing this pendant before, you remember this heirloom as if it were a part of yourself
}

CrashScroll: {
	DisplayName: Crash Scroll
	Tooltip: Leap at your target and use momentum and strength to crash into your enemies
}
