LightningMagic: {
	DisplayName: Lightning Magic
	Tooltip: Allows the user to create swift bolts of destructive lightning.
}

IceMagic: {
	DisplayName: Ice Magic
	Tooltip: Allows the user to generate cold hard ice which can freeze and chill to the blood and bone.
}

MagmaMagic: {
	DisplayName: Magma Magic
	Tooltip: Allows the user to unleash eruptions of thick, molten rock that melts all in its path.
}

WindMagic: {
	DisplayName: Wind Magic
	Tooltip:
		'''
		Allows the user to send turbulent gales that whirl enemies into tumultuous peril.

		Incomplete
		'''
}

AcidMagic: {
	DisplayName: Acid Magic
	Tooltip: Allows the user to form a caustic, reactive liquid that corrodes through enemies.
}

AshMagic: {
	DisplayName: Ash Magic
	Tooltip: Allows the user to shroud the air with smoldering cinders, preserving the most ill-fated as ashen statues.
}

CrystalMagic: {
	DisplayName: Crystal Magic
	Tooltip: Allows the user to materialize luminous crystals which embed themselves in adversaries and brilliantly shatter after high accumulation.
}

EarthMagic: {
	DisplayName: Earth Magic
	Tooltip: Allows the user to generate solid rock to crush enemies under giant boulders and earthen pillars.
}

ExplosionMagic: {
	DisplayName: Explosion Magic
	Tooltip: Allows the user to wreak havoc with massive explosions, leaving any remains singed from combustion.
}

