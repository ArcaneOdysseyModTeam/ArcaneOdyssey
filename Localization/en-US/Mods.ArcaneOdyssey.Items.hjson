SteamImbue: {
	DisplayName: Steam
	Tooltip:
		'''
		By Valve
		Part of the mod internals, just ignore this, any spells with it will cause an error (It's used for imbues)
		'''
}

EmptyScroll: {
	DisplayName: Empty Scroll
	Tooltip: An empty scroll, made of organic paper
}

LeapScroll: {
	DisplayName: Leap Scroll
	Tooltip: Use magic to launch yourself at an upwards angle, the speed and height changing with your selected magic
}

VesuvianSigil: {
	DisplayName: Vesuvian Sigil
	Tooltip:
		'''
		A strange emblem
		RedBirb1508's Vanity Set
		'''
}

EaglePatrimony: {
	DisplayName: Eagle Patrimony
	Tooltip: Despite never seeing this pendant before, you remember this heirloom as if it were a part of yourself
}

CrashScroll: {
	DisplayName: Crash Scroll
	Tooltip:
		'''
		Press {DASHBIND} to activate with a 5 second cooldown
		Leap at your target and use momentum and strength to crash into your enemies
		'''
}

AncientHecateOrb: {
	DisplayName: Hecate Orb
	Tooltip: An orb of unknown origin... the world is really not ready to unleash this
}

ReflexScroll: {
	DisplayName: Reflex Scroll
	Tooltip:
		'''
		An ability which allows the user to channel their imbue to dash
		Grants bonus defense to imbues with slow speed
		'''
}

