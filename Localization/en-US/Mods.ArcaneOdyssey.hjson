# This file will automatically update with entries for new content after a build and reload.

FirstCultistKillDescription: First Lunatic Cultist Defeated

WorldGen: {
	Tucker: Burying Tucker
	Morden: Placing Morden
}

Bestiary: {
	Edgelord: A dark, mysterious man who seems to know you for longer than you remember him. Cursed with immortality and some undisclosed power, yet refuses to hurt anyone. Willing to help you on your journey.
	DebuffDummy: A being older than this world, said to be the source of everything.
}

